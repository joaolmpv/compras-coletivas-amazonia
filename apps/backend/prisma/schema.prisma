// Modelagem relacional multi-ator (OE2 do TCC): comprador, fornecedor, produto,
// hub logistico e lote de compra coletiva, com rateio de frete por participante.
//
// PostgreSQL (producao), substituindo o protótipo anterior em SQLite
// (ver database/prisma/schema.prisma, hoje descontinuado).
//
// E1 (docs/design-backend.md secao 11): adiciona Usuario, SessaoRefreshToken,
// Pagamento, Repasse, LogAuditoria, e amplia StatusLote com ENTREGUE/CANCELADO.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: app_backend (NOINHERIT, sem GRANT direto em tabela alguma --
  // ver design-backend.md secao 12). Migrations usam DIRECT_URL (dono do
  // schema), nao esta.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PapelUsuario {
  COMPRADOR
  FORNECEDOR
  ADMIN
}

enum StatusLote {
  ABERTO
  FECHADO
  DESPACHADO
  ENTREGUE
  CANCELADO
}

// Minimo necessario agora pra desbloquear a decisao de Avaliacao
// verificada (E4) -- a maquina de estados completa (CANDIDATO, transicoes,
// quem pode cancelar por qual motivo) e desenhada depois, no proprio
// escopo "maquina de estados" da E4; este enum pode crescer ou ser
// ajustado quando isso acontecer, nunca editando a migration ja aplicada
// (ESTA, porem, nunca foi aplicada -- corrigida no lugar apos revisao).
//
// So FORNECEDOR_NAO_DESPACHOU libera avaliacao
// (fn_avaliacao_requer_entregue). FORNECEDOR_RECUSOU e
// EXPIRACAO_SEM_CONFIRMACAO acontecem com o lote CANDIDATO, antes de
// existir PedidoLote -- recusar e um direito legitimo do fornecedor, e a
// demora em responder entra no OE4 pela metrica "tempo medio de
// resposta", nao por avaliacao textual. DEMANDA_INSUFICIENTE e o caso do
// lote ABERTO que nao atinge o minimo do fornecedor no prazo -- tambem
// nao e falha do fornecedor, tambem nao libera.
enum MotivoCancelamento {
  FORNECEDOR_RECUSOU
  FORNECEDOR_NAO_DESPACHOU
  EXPIRACAO_SEM_CONFIRMACAO
  DEMANDA_INSUFICIENTE
  ADMIN_OVERRIDE
}

enum StatusPagamento {
  PENDENTE
  RETIDO
  LIBERADO
  REEMBOLSADO
  EXPIRADO
}

enum StatusRepasse {
  AGUARDANDO
  LIBERADO
}

// Credencial de autenticacao, separada da identidade de negocio (Comprador/
// Fornecedor). Admin nao tem perfil (compradorId e fornecedorId ambos null).
// Consistencia papel<->perfil nao e expressavel no schema do Prisma -- ver
// CHECK CONSTRAINT na migration (design-backend.md secao 3.1/11).
model Usuario {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String // argon2id
  role          PapelUsuario
  compradorId   String?              @unique
  comprador     Comprador?           @relation(fields: [compradorId], references: [id])
  fornecedorId  String?              @unique
  fornecedor    Fornecedor?          @relation(fields: [fornecedorId], references: [id])
  refreshTokens SessaoRefreshToken[]
  createdAt     DateTime             @default(now())
}

// Sem RLS -- estado de sessao, nao dado de negocio do comprador. So acessada
// pelo IdentidadeModule/app_auth (SELECT/INSERT/UPDATE/DELETE -- E1/E2),
// nunca por app_comprador diretamente.
model SessaoRefreshToken {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])
  familiaId String // agrupa toda a cadeia de rotacao
  hashToken String    @unique // nunca o token em claro
  usedAt    DateTime?
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([familiaId])
  @@index([expiresAt])
}

model Comprador {
  id          String       @id @default(cuid())
  name        String
  document    String       @unique // CNPJ
  email       String       @unique
  createdAt   DateTime     @default(now())
  usuario     Usuario?
  pedidosLote PedidoLote[]
  avaliacoes  Avaliacao[]
}

model Fornecedor {
  id               String                      @id @default(cuid())
  name             String
  document         String                      @unique // CNPJ
  // Calculado pelo modulo de analise de sentimento (OE4) a partir das avaliacoes.
  reputationScore  Float?
  usuario          Usuario?
  produtos         Produto[]
  avaliacoes       Avaliacao[]
  repasses         Repasse[]
  disponibilidades DisponibilidadeFornecedor[] // D-B (E3)
  createdAt        DateTime                    @default(now())
}

model Produto {
  id                            String                      @id @default(cuid())
  name                          String
  description                   String?
  // Preco por unidadeComercial (ex: preco do "saco 50kg", nao do kg).
  precoPorUnidade               Float
  // Unidades comerciais (decisao 23/11/2026): fornecedor e comprador
  // sempre expressam quantidade em unidadeComercial -- nunca direto em
  // m3/kg. O sistema converte nos dois pontos que precisam de unidade
  // fisica: rateio (m3, via volumePorUnidadeM3 -- ver DisponibilidadeFornecedor.
  // quantidadeMinima/Maxima e PedidoLote.quantidade) e custo de frete do
  // otimizador (kg, via pesoPorUnidadeKg -- peso cubado = max(pesoReal,
  // volumeM3 x fator_cubagem), calculo que fica no microsservico, nao aqui).
  unidadeComercial              String // ex: "saco 50kg"
  pesoPorUnidadeKg              Float // CHECK > 0 na migration
  volumePorUnidadeM3            Float // CHECK > 0 na migration
  fornecedorId                  String
  fornecedor                    Fornecedor                  @relation(fields: [fornecedorId], references: [id])
  lotes                         Lote[]
  // D-B (E3). Dois lados pro MESMO par de modelos -- a relacao simples
  // (so produtoId) e a relacao composta (produtoId+fornecedorId, pra
  // travar fornecedorId contra o dono real do produto) tem que ter nomes
  // diferentes, senao o Prisma nao sabe qual @relation() do outro lado
  // casa com qual. "PorFornecedor" nunca e usado de verdade pela
  // aplicacao (nenhum service navega por ele) -- existe so pra
  // representar a FK composta no schema.prisma, ver nota na migration
  // 20261112150000 (prisma migrate diff reportava essa FK como
  // divergencia antes desta correcao, ja que so existia como SQL puro).
  disponibilidades              DisponibilidadeFornecedor[] @relation("disponibilidade_produto")
  disponibilidadesPorFornecedor DisponibilidadeFornecedor[] @relation("disponibilidade_produto_fornecedor")
  createdAt                     DateTime                    @default(now())

  // Unique redundante com "id" de proposito: e o QUE a FK composta de
  // DisponibilidadeFornecedor(produtoId, fornecedorId) referencia, pra
  // travar no banco que o fornecedorId denormalizado la sempre bate com
  // o fornecedor REAL do produto -- antes disso so a aplicacao garantia.
  // map: nome exato ja criado na migration 20261112150000 -- sem isso o
  // Prisma tentaria dropar e recriar o constraint com o nome default dele.
  @@unique([id, fornecedorId], map: "Produto_id_fornecedorId_key")
}

model HubLogistico {
  id                String                      @id @default(cuid())
  name              String                      @unique
  city              String
  fixedDispatchCost Float // custo fixo por despacho de lote (frete fluvial/aereo)
  variableCostPerM3 Float
  capacityM3        Float
  lotes             Lote[]
  disponibilidades  DisponibilidadeFornecedor[] // D-B (E3)
}

// D-B (decisao 12/11/2026, design-backend.md 13.2): o fornecedor declara,
// por produto X hub, que despacha se o volume acumulado ficar entre
// quantidadeMinima e quantidadeMaxima dentro do prazo. Uma linha por
// combinacao produto+hub (decisao aprovada -- nao m:n: hubs diferentes
// podem ter limites diferentes, ex. hub mais distante aceita volume
// minimo menor). fornecedorId e denormalizado de produto.fornecedorId de
// proposito -- RLS compara coluna direta contra app.fornecedor_id, nunca
// um subselect em Produto (mesmo padrao de produto_update_fornecedor).
// Consistencia fornecedorId<->produtoId e ESTRUTURAL (FK composta
// DisponibilidadeFornecedor_produto_fornecedor_fkey, abaixo), nao so
// aplicacao -- a checagem em DisponibilidadesService.criar continua
// existindo como defesa em profundidade (da um 403 SEM_PERMISSAO cedo,
// em vez de deixar a violacao de FK chegar como erro generico).
model DisponibilidadeFornecedor {
  id                    String       @id @default(cuid())
  produtoId             String
  produto               Produto      @relation("disponibilidade_produto", fields: [produtoId], references: [id])
  // Relacao SO pra representar a FK composta no banco (ver nota em
  // Produto.disponibilidadesPorFornecedor) -- nunca navegada pela
  // aplicacao, o campo "produto" acima e que e usado de verdade.
  produtoFornecedor     Produto      @relation("disponibilidade_produto_fornecedor", fields: [produtoId, fornecedorId], references: [id, fornecedorId], map: "DisponibilidadeFornecedor_produto_fornecedor_fkey")
  fornecedorId          String
  fornecedor            Fornecedor   @relation(fields: [fornecedorId], references: [id])
  hubId                 String
  hub                   HubLogistico @relation(fields: [hubId], references: [id])
  // Decisao 23/11/2026 (unidades comerciais): quantidade declarada em
  // unidadeComercial do PRODUTO (Produto.unidadeComercial), nao em m3 --
  // sufixo M3 (nome anterior, migration 20261112150000) virou errado
  // quando o fornecedor passou a declarar quantidade em unidades
  // comerciais ("20 sacos"), nao em m3 direto. m3 e CALCULADO (quantidade
  // x produto.volumePorUnidadeM3) sempre no momento do uso, nunca
  // armazenado aqui -- evita ficar desatualizado se volumePorUnidadeM3 do
  // produto mudar depois.
  quantidadeMinima      Float // minimo de despacho -- CHECK <= quantidadeMaxima na migration
  quantidadeMaxima      Float // maximo disponivel
  prazoMaximoEsperaDias Int
  vigenciaInicio        DateTime     @default(now())
  // NULL = vigente agora. A unicidade "uma vigente por produto x hub" e
  // um INDICE PARCIAL (WHERE "vigenciaFim" IS NULL), nao expressavel no
  // schema do Prisma -- vive so no SQL da migration. @@unique() comum
  // aqui impediria reabrir uma disponibilidade apos encerrar a anterior
  // (historico preservado), que e o objetivo.
  vigenciaFim           DateTime?
  createdAt             DateTime     @default(now())

  @@index([produtoId, hubId])
}

model Lote {
  id                 String              @id @default(cuid())
  produtoId          String
  produto            Produto             @relation(fields: [produtoId], references: [id])
  hubId              String
  hub                HubLogistico        @relation(fields: [hubId], references: [id])
  status             StatusLote          @default(ABERTO)
  totalVolumeM3      Float               @default(0)
  totalCost          Float? // preenchido quando o lote fecha (custo fixo + variavel do hub)
  dispatchDate       DateTime?
  motivoCancelamento MotivoCancelamento? // so preenchido quando status = CANCELADO
  createdAt          DateTime            @default(now())
  pedidosLote        PedidoLote[]
  repasse            Repasse?
}

model PedidoLote {
  id          String     @id @default(cuid())
  loteId      String
  lote        Lote       @relation(fields: [loteId], references: [id])
  compradorId String
  comprador   Comprador  @relation(fields: [compradorId], references: [id])
  // Decisao 23/11/2026 (unidades comerciais): quantidade em
  // unidadeComercial do produto do lote (Produto.unidadeComercial), nao
  // mais m3 direto (nome anterior era volumeM3) -- o comprador declara
  // "quero 10 sacos", nao "quero 2 m3". m3 (pro rateio/fn_breakdown_lote)
  // e calculado via produto.volumePorUnidadeM3, nunca armazenado aqui.
  quantidade  Float
  // costShare continua em R$ -- nao afetado pela mudanca de unidade.
  // Valor rateado do frete deste lote proporcional ao volume do comprador --
  // calculado de forma transacional no fechamento do lote (ver OE2 no README).
  // Nullable, sem DEFAULT: so e preenchido pelo backend (app_service) no
  // fechamento -- app_comprador nao tem GRANT UPDATE nesta coluna (ver
  // migration de GRANTs por coluna, design-backend.md secao 4.4).
  costShare   Float?
  pagamento   Pagamento?
  avaliacao   Avaliacao?

  @@unique([loteId, compradorId])
}

// Escrow simulado por PedidoLote (design-backend.md secao 5.2). Sem RLS
// nesta etapa (E1) -- GRANTs/politicas de acesso ficam para a E4, quando o
// endpoint de pagamento for implementado.
model Pagamento {
  id           String          @id @default(cuid())
  pedidoLoteId String          @unique
  pedidoLote   PedidoLote      @relation(fields: [pedidoLoteId], references: [id])
  status       StatusPagamento @default(PENDENTE)
  valor        Float // = costShare do PedidoLote no momento da criacao
  gatewayRef   String? // referencia do gateway fake
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Repasse agregado ao fornecedor, criado quando o Lote entra em ENTREGUE
// (design-backend.md secao 5.2). Sem RLS nesta etapa (E1), mesma razao do Pagamento.
model Repasse {
  id           String        @id @default(cuid())
  loteId       String        @unique
  lote         Lote          @relation(fields: [loteId], references: [id])
  fornecedorId String
  fornecedor   Fornecedor    @relation(fields: [fornecedorId], references: [id])
  valorTotal   Float // soma dos Pagamento.valor LIBERADO deste lote
  status       StatusRepasse @default(AGUARDANDO)
  createdAt    DateTime      @default(now())
}

model Avaliacao {
  id             String     @id @default(cuid())
  fornecedorId   String
  fornecedor     Fornecedor @relation(fields: [fornecedorId], references: [id])
  compradorId    String
  comprador      Comprador  @relation(fields: [compradorId], references: [id])
  // Avaliacao verificada (decisao E4, 12/11/2026): uma avaliacao por
  // pedido, nunca criada livremente -- o trigger fn_avaliacao_requer_entregue
  // (migration dedicada) e quem decide se pode existir, nao so esta FK.
  pedidoLoteId   String     @unique
  pedidoLote     PedidoLote @relation(fields: [pedidoLoteId], references: [id])
  rating         Int // 1 a 5
  comment        String?
  // Preenchido de forma assincrona pela Google Cloud Natural Language API (OE4).
  sentimentScore Float?
  createdAt      DateTime   @default(now())
}

// Log de auditoria append-only (design-backend.md secao 6). entidade/entidadeId
// sao referencias textuais, nao FK -- esta tabela precisa sobreviver mesmo que
// a linha referenciada em outra tabela seja removida (nao deveria acontecer,
// mas a trilha de auditoria nao pode depender disso). hashAnterior/hashAtual
// formam a cadeia; a logica de calculo (advisory lock + sha256) e aplicacao
// (E6), nao esta migration -- aqui so a tabela e as garantias de imutabilidade
// (REVOKE + trigger, ver migration dedicada).
model LogAuditoria {
  id              String   @id @default(cuid())
  entidade        String
  entidadeId      String
  acao            String
  atorId          String? // null = job automatico/sistema
  versaoAlgoritmo String? // tag do otimizador, quando a acao envolve o AG
  hashEntrada     String? // sha256 do payload de entrada, para acoes que chamam o otimizador
  dadosDepois     Json
  hashAnterior    String
  hashAtual       String   @unique
  createdAt       DateTime @default(now())

  @@index([entidade, entidadeId])
}
